# Go
# Leading slashes anchor these to the repo root — unanchored, "byteforge"
# would also match (and silently exclude from git) the cmd/byteforge/
# source directory, since gitignore patterns match at any depth by default.
/bin/
*.test
*.out
/byteforge
/byteforge.exe

# SQLite data
*.db
*.db-journal
*.db-shm
*.db-wal
data/
.e2e.db*

# Node / web
web/node_modules/
web/dist/
web/.vite/
web/coverage/
web/playwright-report/
web/test-results/
web/*.tsbuildinfo

# Env
.env
.env.local
*.local

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
